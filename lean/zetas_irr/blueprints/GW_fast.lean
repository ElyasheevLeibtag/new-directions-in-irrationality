/-
# Exact integer evaluation of the six-step blocks of the walk `p_N → p_{N+1}`

`stepList` records, for each of the 72 edges of `CMF_path.lean`, whether the edge is forward,
the constant parts of `α_i = a_i - 1` and `b_j` at the source point (their `N`-parts are
`(11, 12, -16, -17, 10)` and `(0, 1, 2, -1, -2)`), and the constant `c = ck N + cc` of the
linear factor. `runBlock n b` multiplies the rows of the identity by the integer matrices
`d₄ • Amat` (forward) and `d₄ • adj Amat` (backward) of the six steps `6b, …, 6b+5`.
`certs` holds, for every block, polynomials `D_b`, `N_{b,ij}` (coefficients in base `2⁸⁰`,
shifted by `2⁷⁹`) with `blk (block b) = N_b / D_b`; `check b n` tests this at `n`.
-/

namespace ZetasIrr.GW

structure SD where
  fwd : Bool
  a0 : Int
  a1 : Int
  a2 : Int
  a3 : Int
  a4 : Int
  b0 : Int
  b1 : Int
  b2 : Int
  b3 : Int
  b4 : Int
  ck : Int
  cc : Int
  deriving DecidableEq

structure V4 where
  x0 : Int
  x1 : Int
  x2 : Int
  x3 : Int

structure St where
  r0 : V4
  r1 : V4
  r2 : V4
  r3 : V4
  s : Int

structure E5 where
  e1 : Int
  e2 : Int
  e3 : Int
  e4 : Int
  e5 : Int

def E5.push (E : E5) (v : Int) : E5 :=
  ⟨E.e1 + v, E.e2 + E.e1 * v, E.e3 + E.e2 * v, E.e4 + E.e3 * v, E.e5 + E.e4 * v⟩

def esym (v0 v1 v2 v3 v4 : Int) : E5 :=
  ((((E5.mk v0 0 0 0 0).push v1).push v2).push v3).push v4

structure DC where
  d0 : Int
  d1 : Int
  d2 : Int
  d3 : Int
  d4 : Int
  c : Int

def mkDC (A B : E5) (c : Int) : DC :=
  ⟨B.e5 - A.e5, A.e4 - B.e4, B.e3 - A.e3, A.e2 - B.e2, B.e1 - A.e1, c⟩

def sdDC (n : Int) (sd : SD) : DC :=
  mkDC (esym (11 * n + sd.a0) (12 * n + sd.a1) (-16 * n + sd.a2) (-17 * n + sd.a3)
      (10 * n + sd.a4))
    (esym sd.b0 (n + sd.b1) (2 * n + sd.b2) (-n + sd.b3) (-2 * n + sd.b4)) (sd.ck * n + sd.cc)

def fwdRow (D : DC) (k : Int) (v : V4) : V4 :=
  ⟨v.x0 * k - v.x1 * D.d4, v.x1 * k - v.x2 * D.d4, v.x2 * k - v.x3 * D.d4,
   v.x0 * D.d0 + v.x1 * D.d1 + v.x2 * D.d2 + v.x3 * (k + D.d3)⟩

structure HH where
  h1 : Int
  h2 : Int
  h3 : Int
  dv : Int

def mkHH3 (D : DC) (h3 : Int) : HH :=
  let h2 := D.d2 + D.c * h3
  let h1 := D.d1 + D.c * h2
  ⟨h1, h2, h3, D.d0 + D.c * h1⟩

def mkHH (D : DC) : HH := mkHH3 D (D.d3 + D.c * D.d4)

def bwdRow3 (D : DC) (H : HH) (v : V4) (u0 : Int) : V4 :=
  let u1 := D.c * u0 - H.dv * v.x0
  let u2 := D.c * u1 - H.dv * v.x1
  ⟨u0, u1, u2, D.c * u2 - H.dv * v.x2⟩

def bwdRow (D : DC) (H : HH) (v : V4) : V4 :=
  bwdRow3 D H v (v.x0 * H.h1 + v.x1 * H.h2 + v.x2 * H.h3 + v.x3 * D.d4)

def stepD (S : St) (D : DC) (fwd : Bool) : St :=
  if fwd then
    ⟨fwdRow D (D.d4 * D.c) S.r0, fwdRow D (D.d4 * D.c) S.r1, fwdRow D (D.d4 * D.c) S.r2,
      fwdRow D (D.d4 * D.c) S.r3, S.s * D.d4⟩
  else
    ⟨bwdRow D (mkHH D) S.r0, bwdRow D (mkHH D) S.r1, bwdRow D (mkHH D) S.r2,
      bwdRow D (mkHH D) S.r3, S.s * (mkHH D).dv⟩

def step (n : Int) (S : St) (sd : SD) : St := stepD S (sdDC n sd) sd.fwd

