def fareyL (i : ℕ) : ℕ × ℕ := farey.getD i (0, 1)

def rowN (i : ℕ) : ℕ × ℕ × ℕ × ℕ × ℕ × ℕ := ptableN.getD (ri.getD i 0) (0, 1, 0, 1, 0, 0)

/-- The chamber data `⌊c · a/b⌋` for `|c| ≤ 29`. -/
def wOf (a b : ℕ) (c : ℤ) : ℤ :=
  if 0 < c then (c * a) / b else if c = 0 then 0 else -(((-c) * a) / b) - 1

/-- No fraction with denominator `≤ 29` lies strictly inside `(a/b, a'/b')`. -/
def noFracN (a b a' b' : ℕ) : Bool :=
  (List.range 29).all fun c => decide (¬ (((c + 1) * a / b + 1) * b' < (c + 1) * a'))

/-- The arithmetic check of chamber `i`. -/
def chamberOK (i : ℕ) : Bool :=
  let l := fareyL i
  let r := fareyL (i + 1)
  let row := rowN i
  let w := wOf l.1 l.2
  decide (0 < l.2 ∧ 0 < r.2 ∧ l.2 ≤ 29 ∧ r.2 ≤ 29 ∧ l.1 * r.2 < r.1 * l.2) &&
  decide (certI w ≤ (row.2.2.2.2.1 : ℤ) + (if l.2 ≤ 19 * l.1 then 1 else 0)) &&
  decide (certP w ≤ (row.2.2.2.2.2 : ℤ) + 1) &&
  decide (0 < row.2.1 ∧ 0 < row.2.2.2.1 ∧ row.1 * l.2 ≤ l.1 * row.2.1 ∧
    r.1 * row.2.2.2.1 ≤ row.2.2.1 * r.2) &&
  ptableN.all (fun q => decide (q = row ∨ (0 < q.2.2.2.1 ∧ q.2.2.1 * l.2 ≤ l.1 * q.2.2.2.1) ∨
    (0 < q.2.1 ∧ r.1 * q.2.1 ≤ q.1 * r.2))) &&
  noFracN l.1 l.2 r.1 r.2 &&
  decide (l.2 ≤ 19 * l.1 ∨ 19 * r.1 ≤ r.2) &&
  decide (row ∈ ptableN)

theorem farey_first : fareyL 0 = (0, 1) := rfl
theorem farey_last : fareyL 270 = (1, 1) := rfl

