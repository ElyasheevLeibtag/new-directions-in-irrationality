def pevalNat (l : List Nat) (n : Nat) : Nat := l.foldr (fun a acc => Nat.add a (Nat.mul n acc)) 0

def entry (lp ln : List Nat) (n : Nat) : Int := Int.ofNat (pevalNat lp n) - Int.ofNat (pevalNat ln n)

def forceI {α : Type} (a : Int) (k : Int → α) : α :=
  Int.casesOn (motive := fun _ => α) a
    (fun n => Nat.casesOn (motive := fun _ => α) n (k (Int.ofNat 0)) fun m => k (Int.ofNat (m + 1)))
    fun n => Nat.casesOn (motive := fun _ => α) n (k (Int.negSucc 0)) fun m => k (Int.negSucc (m + 1))

structure V3 where
  x0 : Int
  x1 : Int
  x2 : Int

def V3.force {α : Type} (v : V3) (k : V3 → α) : α :=
  forceI v.x0 fun x0 => forceI v.x1 fun x1 => forceI v.x2 fun x2 => k ⟨x0, x1, x2⟩

structure M3 where
  r0 : V3
  r1 : V3
  r2 : V3

def M3.force {α : Type} (A : M3) (k : M3 → α) : α :=
  A.r0.force fun r0 => A.r1.force fun r1 => A.r2.force fun r2 => k ⟨r0, r1, r2⟩

def M3.tmulVec (A : M3) (v : V3) : V3 :=
  ⟨A.r0.x0 * v.x0 + A.r1.x0 * v.x1 + A.r2.x0 * v.x2,
   A.r0.x1 * v.x0 + A.r1.x1 * v.x1 + A.r2.x1 * v.x2,
   A.r0.x2 * v.x0 + A.r1.x2 * v.x1 + A.r2.x2 * v.x2⟩

def M3.tmulVecF {α : Type} (A : M3) (v : V3) (k : V3 → α) : α := (A.tmulVec v).force k

def det3 (a b c : V3) : Int :=
  a.x0 * (b.x1 * c.x2 - b.x2 * c.x1) - a.x1 * (b.x0 * c.x2 - b.x2 * c.x0) +
    a.x2 * (b.x0 * c.x1 - b.x1 * c.x0)

def blockN (b : Nat) (n : Nat) : M3 :=
  let D := blockData b
  ⟨⟨entry D.p00 D.n00 n, entry D.p01 D.n01 n, entry D.p02 D.n02 n⟩,
   ⟨entry D.p10 D.n10 n, entry D.p11 D.n11 n, entry D.p12 D.n12 n⟩,
   ⟨entry D.p20 D.n20 n, entry D.p21 D.n21 n, entry D.p22 D.n22 n⟩⟩

def blockF {α : Type} (b : Nat) (n : Nat) (k : M3 → α) : α := (blockN b n).force k

structure Blocks where
  b0 : M3
  b1 : M3
  b2 : M3
  b3 : M3
  b4 : M3
  b5 : M3
  b6 : M3
  b7 : M3
  b8 : M3
  b9 : M3
  b10 : M3
  b11 : M3

def blocksF {α : Type} (n : Nat) (k : Blocks → α) : α :=
  blockF 0 n fun B0 => blockF 1 n fun B1 => blockF 2 n fun B2 => blockF 3 n fun B3 => blockF 4 n fun B4 => blockF 5 n fun B5 => blockF 6 n fun B6 => blockF 7 n fun B7 => blockF 8 n fun B8 => blockF 9 n fun B9 => blockF 10 n fun B10 => blockF 11 n fun B11 => k ⟨B0, B1, B2, B3, B4, B5, B6, B7, B8, B9, B10, B11⟩

def blocks (n : Nat) : Blocks := ⟨blockN 0 n, blockN 1 n, blockN 2 n, blockN 3 n, blockN 4 n, blockN 5 n, blockN 6 n, blockN 7 n, blockN 8 n, blockN 9 n, blockN 10 n, blockN 11 n⟩

def NTB {α : Type} (B : Blocks) (v : V3) (k : V3 → α) : α :=
  v.force fun v0 => B.b0.tmulVecF v0 fun v1 => B.b1.tmulVecF v1 fun v2 => B.b2.tmulVecF v2 fun v3 => B.b3.tmulVecF v3 fun v4 => B.b4.tmulVecF v4 fun v5 => B.b5.tmulVecF v5 fun v6 => B.b6.tmulVecF v6 fun v7 => B.b7.tmulVecF v7 fun v8 => B.b8.tmulVecF v8 fun v9 => B.b9.tmulVecF v9 fun v10 => B.b10.tmulVecF v10 fun v11 => B.b11.tmulVecF v11 fun v12 => k v12

def NT2B {α : Type} (B : Blocks) (v u : V3) (k : V3 → V3 → α) : α :=
  v.force fun v0 => u.force fun u0 => B.b0.tmulVecF v0 fun v1 => B.b0.tmulVecF u0 fun u1 => B.b1.tmulVecF v1 fun v2 => B.b1.tmulVecF u1 fun u2 => B.b2.tmulVecF v2 fun v3 => B.b2.tmulVecF u2 fun u3 => B.b3.tmulVecF v3 fun v4 => B.b3.tmulVecF u3 fun u4 => B.b4.tmulVecF v4 fun v5 => B.b4.tmulVecF u4 fun u5 => B.b5.tmulVecF v5 fun v6 => B.b5.tmulVecF u5 fun u6 => B.b6.tmulVecF v6 fun v7 => B.b6.tmulVecF u6 fun u7 => B.b7.tmulVecF v7 fun v8 => B.b7.tmulVecF u7 fun u8 => B.b8.tmulVecF v8 fun v9 => B.b8.tmulVecF u8 fun u9 => B.b9.tmulVecF v9 fun v10 => B.b9.tmulVecF u9 fun u10 => B.b10.tmulVecF v10 fun v11 => B.b10.tmulVecF u10 fun u11 => B.b11.tmulVecF v11 fun v12 => B.b11.tmulVecF u11 fun u12 => k v12 u12

def NTspec (B : Blocks) (v : V3) : V3 :=
  B.b11.tmulVec (B.b10.tmulVec (B.b9.tmulVec (B.b8.tmulVec (B.b7.tmulVec (B.b6.tmulVec (B.b5.tmulVec (B.b4.tmulVec (B.b3.tmulVec (B.b2.tmulVec (B.b1.tmulVec (B.b0.tmulVec (v))))))))))))

def hv (n : Nat) : V3 := ⟨1, 10 * (n : Int) + 1, (10 * (n : Int) + 1) * (10 * (n : Int) + 1)⟩

def PvalB (n : Nat) (Bn Bn1 : Blocks) : Int :=
  NTB Bn (hv n) fun w => NT2B Bn1 w (hv (n + 1)) fun c0 c1 => (hv (n + 2)).force fun c2 => det3 c0 c1 c2

def PvalS (n : Nat) : Int :=
  det3 (NTspec (blocks (n + 1)) (NTspec (blocks n) (hv n))) (NTspec (blocks (n + 1)) (hv (n + 1)))
    (hv (n + 2))

