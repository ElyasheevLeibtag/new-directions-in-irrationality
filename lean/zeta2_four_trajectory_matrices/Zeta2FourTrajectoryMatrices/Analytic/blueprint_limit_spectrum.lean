theorem hP10 : (1 + (10 : ℚ)⁻¹ • Tinf) ^ 10 = P10 := by decide +kernel

theorem hP9 : (1 + (9 : ℚ)⁻¹ • Tinf) ^ 9 = P9 := by decide +kernel

theorem hP11 : (1 + (11 : ℚ)⁻¹ • Tinf) ^ 11 = P11 := by decide +kernel

theorem hI11 : (1 - (11 : ℚ)⁻¹ • Tinf)⁻¹ = I11 := Matrix.inv_eq_left_inv (by decide +kernel)

theorem hQ11 : I11 ^ 11 = Q11 := by decide +kernel

theorem hI2 : (1 + (2 : ℚ)⁻¹ • Tinf)⁻¹ = I2 := Matrix.inv_eq_left_inv (by decide +kernel)

theorem hQ2 : I2 ^ 2 = Q2 := by decide +kernel

theorem hI1 : (1 + Tinf)⁻¹ = I1 := Matrix.inv_eq_left_inv (by decide +kernel)

theorem hI3 : (1 + (3 : ℚ)⁻¹ • Tinf)⁻¹ = I3 := Matrix.inv_eq_left_inv (by decide +kernel)

theorem hQ3 : I3 ^ 3 = Q3 := by decide +kernel

theorem Ainf_eq : Ainf = Aex := by
  rw [Ainf, hP10, hP9, hP11, hI11, hQ11, hI2, hQ2, hI1, hI3, hQ3]
  decide +kernel

theorem charpoly_fin_three (M : Matrix (Fin 3) (Fin 3) ℚ) :
    M.charpoly = X ^ 3 - C (M 0 0 + M 1 1 + M 2 2) * X ^ 2 +
      C (M 0 0 * M 1 1 - M 0 1 * M 1 0 + (M 0 0 * M 2 2 - M 0 2 * M 2 0) +
        (M 1 1 * M 2 2 - M 1 2 * M 2 1)) * X - C M.det := by
  rw [Matrix.charpoly, Matrix.det_fin_three, Matrix.det_fin_three, Matrix.charmatrix_apply_eq,
    Matrix.charmatrix_apply_eq, Matrix.charmatrix_apply_eq,
    Matrix.charmatrix_apply_ne M 0 1 (by decide),
    Matrix.charmatrix_apply_ne M 0 2 (by decide),
    Matrix.charmatrix_apply_ne M 1 0 (by decide),
    Matrix.charmatrix_apply_ne M 1 2 (by decide),
    Matrix.charmatrix_apply_ne M 2 0 (by decide),
    Matrix.charmatrix_apply_ne M 2 1 (by decide)]
  simp only [C_add, C_sub, C_mul]
  ring

def c0 : ℚ := 1855425871872 / 895833302668638834554683750087890625
def c1 : ℚ := 6119917581009155345396562793851904 / 32000061404626447809127858236889541015625
def c2 : ℚ := 266957778538934989798238376160038092809 / 15342324857928574809549553125

theorem e2 : -(Aex 0 0 + Aex 1 1 + Aex 2 2) = c2 := by decide +kernel

theorem e1 : Aex 0 0 * Aex 1 1 - Aex 0 1 * Aex 1 0 + (Aex 0 0 * Aex 2 2 - Aex 0 2 * Aex 2 0) +
    (Aex 1 1 * Aex 2 2 - Aex 1 2 * Aex 2 1) = c1 := by decide +kernel

theorem e0 : -Aex.det = c0 := by
  rw [Matrix.det_fin_three]
  decide +kernel

theorem charpoly_Ainf : Ainf.charpoly = X ^ 3 + C c2 * X ^ 2 + C c1 * X + C c0 := by
  rw [Ainf_eq, charpoly_fin_three, ← e2, ← e1, ← e0, C_neg, C_neg]
  ring

theorem coeff0 : Ainf.charpoly.coeff 0 = c0 := by
  rw [charpoly_Ainf]
  simp [coeff_X]

theorem coeff1 : Ainf.charpoly.coeff 1 = c1 := by
  rw [charpoly_Ainf]
  simp

theorem coeff2 : Ainf.charpoly.coeff 2 = c2 := by
  rw [charpoly_Ainf]
  simp

theorem disc_neg : 18 * c2 * c1 * c0 - 4 * c2 ^ 3 * c0 + c2 ^ 2 * c1 ^ 2 - 4 * c1 ^ 3 -
    27 * c0 ^ 2 < 0 := by decide +kernel

def g (x : ℝ) : ℝ := x ^ 3 - (c2 : ℝ) * x ^ 2 + (c1 : ℝ) * x - (c0 : ℝ)

theorem aeval_charpoly (x : ℝ) : aeval (-x) Ainf.charpoly = -g x := by
  rw [charpoly_Ainf, g]
  simp only [map_add, map_mul, aeval_X_pow, aeval_X, aeval_C, eq_ratCast]
  ring

theorem g_lo : g 17400086428 < 0 := by
  rw [g, c0, c1, c2]
  push_cast
  norm_num

theorem g_hi : 0 < g 17400086429 := by
  rw [g, c0, c1, c2]
  push_cast
  norm_num

theorem real_root : ∃ Λ : ℝ, 17400086428 < Λ ∧ Λ < 17400086429 ∧ aeval (-Λ) Ainf.charpoly = 0 ∧
    (c0 : ℝ) / Λ < 1 := by
  have hc : Continuous g := by
    unfold g
    fun_prop
  obtain ⟨Λ, ⟨hΛ1, hΛ2⟩, h0⟩ := intermediate_value_Ioo
    (by norm_num : (17400086428 : ℝ) ≤ 17400086429) hc.continuousOn ⟨g_lo, g_hi⟩
  refine ⟨Λ, hΛ1, hΛ2, by rw [aeval_charpoly, h0, neg_zero], ?_⟩
  rw [div_lt_one (by linarith)]
  have : (c0 : ℝ) < 1 := by
    rw [c0]
    push_cast
    norm_num
  linarith

theorem obs_det : (Matrix.of fun i j : Fin 3 => (Ainf ^ (j : ℕ)) i 0).det =
    72143259339220303025804927524593090645506084475442025307751136603648 /
      28469599455181793682074031322586982029718987334183867584429931640625 := by
  rw [Ainf_eq, Matrix.det_fin_three]
  simp only [Matrix.of_apply]
  decide +kernel

theorem limit_spectrum :
    let c₀ : ℚ := 1855425871872 / 895833302668638834554683750087890625
    let c₁ : ℚ := 6119917581009155345396562793851904 /
      32000061404626447809127858236889541015625
    let c₂ : ℚ := 266957778538934989798238376160038092809 / 15342324857928574809549553125
    Ainf.charpoly.coeff 0 = c₀ ∧ Ainf.charpoly.coeff 1 = c₁ ∧ Ainf.charpoly.coeff 2 = c₂ ∧
    18 * c₂ * c₁ * c₀ - 4 * c₂ ^ 3 * c₀ + c₂ ^ 2 * c₁ ^ 2 - 4 * c₁ ^ 3 - 27 * c₀ ^ 2 < 0 ∧
    (∃ Λ : ℝ, 17400086428 < Λ ∧ Λ < 17400086429 ∧ aeval (-Λ) Ainf.charpoly = 0 ∧
      (c₀ : ℝ) / Λ < 1) ∧
    (Matrix.of fun i j : Fin 3 => (Ainf ^ (j : ℕ)) i 0).det =
      72143259339220303025804927524593090645506084475442025307751136603648 /
        28469599455181793682074031322586982029718987334183867584429931640625 :=
  ⟨coeff0, coeff1, coeff2, disc_neg, real_root, obs_det⟩

