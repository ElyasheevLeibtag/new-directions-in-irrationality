/-
# Helper for `ShellFirstOrder` [1]: the shell chamber certificate at `t = 0`

For `f` in a shell of the table and `y ∈ [0, 1)`, the ten `t = 0` endpoints are
`⌊uf - y⌋ = ⌊uf⌋ - [{uf} < y]`, `⌈-uf - y⌉ = -⌊uf⌋ - [1 - {uf} ≤ y]`,
`⌊-uf - y⌋ = -⌊uf⌋ - 1 - [1 - {uf} < y]`, `⌊-y⌋ + 1 = 1 - [0 < y]`. Each shell is cut into the
open cells between consecutive Farey fractions of order `≤ 29` (47 cells in all, generated by a
Python script and stored as literals in `certCells`). On a cell the seven floors
`⌊f⌋, ⌊2f⌋, ⌊10f⌋, ⌊11f⌋, ⌊12f⌋, ⌊16f⌋, ⌊17f⌋` are constant (checked at the cell endpoints), and
the ten `y`-thresholds `0, {f}, {2f}, {10f}, {11f}, {12f}, 1-{f}, 1-{2f}, 1-{16f}, 1-{17f}` have a
fixed strict order `σ` (affine in `f`, checked at the endpoints). Hence the ten threshold bits
at `(f, y)` are monotone along `σ`, and the kernel checks the claim for every monotone bit
vector (`cellOK`, by `decide +kernel`, one theorem per shell). `cell_sound` transfers the check to
the actual `(f, y)`; `cert_main` is the result.
-/
import Mathlib

namespace Meijer5255.ShellFirstOrder.Cert

/-- A cell `(c, d, q, σ)`: an open interval `(c, d)` of `f`, the floors
`q = [⌊f⌋, ⌊2f⌋, ⌊10f⌋, ⌊11f⌋, ⌊12f⌋, ⌊16f⌋, ⌊17f⌋]` on it, and the increasing order `σ` of the
ten `y`-thresholds on it. -/
abbrev Cell := ℚ × ℚ × List ℤ × List ℕ

/-- Entry `i` of an integer list (`0` past the end). -/
def qOf (q : List ℤ) (i : ℕ) : ℤ := q.getD i 0

/-- The ten `y`-thresholds `0, {f}, {2f}, {10f}, {11f}, {12f}, 1-{f}, 1-{2f}, 1-{16f}, 1-{17f}`
(written with the floors `q`). -/
def thr (q : List ℤ) (f : ℚ) : ℕ → ℚ
  | 0 => 0
  | 1 => f - qOf q 0
  | 2 => 2 * f - qOf q 1
  | 3 => 10 * f - qOf q 2
  | 4 => 11 * f - qOf q 3
  | 5 => 12 * f - qOf q 4
  | 6 => 1 - f + qOf q 0
  | 7 => 1 - 2 * f + qOf q 1
  | 8 => 1 - 16 * f + qOf q 5
  | _ => 1 - 17 * f + qOf q 6

/-- Bit `i` of a Boolean list as an integer. -/
def bv (bs : List Bool) (i : ℕ) : ℤ := if bs.getD i false then 1 else 0

/-- The ten `t = 0` endpoints in terms of the floors and the threshold bits. -/
def endsB (q : List ℤ) (bs : List Bool) : List (ℤ × ℤ) :=
  [(1 - bv bs 0, qOf q 2 - bv bs 3), (qOf q 0 - bv bs 1 + 1, qOf q 3 - bv bs 4),
   (qOf q 1 - bv bs 2 + 1, qOf q 4 - bv bs 5), (-qOf q 6 - bv bs 9, -qOf q 0 - 1 - bv bs 6),
   (-qOf q 5 - bv bs 8, -qOf q 1 - 1 - bv bs 7)]

/-- Number of integers in `[L, U]`. -/
def icnt (L U : ℤ) : ℤ := max 0 (U - L + 1)

/-- `h = #N₀ + #N₁ + #N₂ - #D₀ - #D₁` from the bits. -/
def hB (q : List ℤ) (bs : List Bool) : ℤ :=
  icnt (1 - bv bs 0) (qOf q 2 - bv bs 3) + icnt (qOf q 0 - bv bs 1 + 1) (qOf q 3 - bv bs 4) +
      icnt (qOf q 1 - bv bs 2 + 1) (qOf q 4 - bv bs 5) -
    icnt (-qOf q 6 - bv bs 9) (-qOf q 0 - 1 - bv bs 6) -
    icnt (-qOf q 5 - bv bs 8) (-qOf q 1 - 1 - bv bs 7)

/-- `ε₀ = ⌊2f - y⌋` from the bits. -/
def epsB (q : List ℤ) (bs : List Bool) : ℤ := qOf q 1 - bv bs 2

/-- The certified property at one bit vector. -/
def goodB (q : List ℤ) (bs : List Bool) (row : List (ℤ × ℤ)) : Bool :=
  decide (-1 ≤ hB q bs) && (!decide (hB q bs = -1) ||
    decide ((endsB q bs).map (fun e => (e.1 - epsB q bs, e.2 - epsB q bs)) = row))

/-- The bits are monotone along `σ`. -/
def chainOK (σ : List ℕ) (bs : List Bool) : Bool :=
  (σ.zip σ.tail).all fun pr => !(bs.getD pr.2 false) || bs.getD pr.1 false

/-- All Boolean lists of length `n`. -/
def allVecs : ℕ → List (List Bool)
  | 0 => [[]]
  | n + 1 => (allVecs n).flatMap fun v => [false :: v, true :: v]

/-- The multipliers of the floors. -/
def mults : List ℚ := [1, 2, 10, 11, 12, 16, 17]

/-- The floors are constant on `(c, d)`. -/
def qOK (c d : ℚ) (q : List ℤ) : Bool :=
  decide (q.length = 7) && (mults.zip q).all fun mq =>
    decide ((mq.2 : ℚ) ≤ mq.1 * c) && decide (mq.1 * d ≤ mq.2 + 1)

/-- The thresholds are strictly increasing along `σ` on `(c, d)` (affine in `f`: checked at the
endpoints). -/
def ordOK (c d : ℚ) (q : List ℤ) (σ : List ℕ) : Bool :=
  σ.all (· < 10) && (σ.zip σ.tail).all fun pr =>
    decide (0 ≤ thr q c pr.2 - thr q c pr.1) && decide (0 ≤ thr q d pr.2 - thr q d pr.1) &&
      decide (0 < (thr q c pr.2 - thr q c pr.1) + (thr q d pr.2 - thr q d pr.1))

/-- The check of one cell. -/
def cellOK (row : List (ℤ × ℤ)) (cell : Cell) : Bool :=
  decide (cell.1 < cell.2.1) && decide (cell.2.1.den ≤ 29) && qOK cell.1 cell.2.1 cell.2.2.1 &&
    ordOK cell.1 cell.2.1 cell.2.2.1 cell.2.2.2 &&
    (allVecs 10).all fun bs => !(chainOK cell.2.2.2 bs) || goodB cell.2.2.1 bs row

/-- The cells cover `[a, b]` consecutively. -/
def covers : ℚ → ℚ → List Cell → Bool
  | _, _, [] => false
  | a, b, [cell] => decide (cell.1 = a) && decide (cell.2.1 = b)
  | a, b, cell :: rest => decide (cell.1 = a) && covers cell.2.1 b rest

