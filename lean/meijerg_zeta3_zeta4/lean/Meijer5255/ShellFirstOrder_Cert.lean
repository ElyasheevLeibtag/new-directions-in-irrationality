/-! ### Soundness of the cell check -/

theorem fl0 (y : ℚ) (hy0 : 0 ≤ y) (hy1 : y < 1) :
    ⌊-y⌋ + 1 = 1 - (if 0 < y then 1 else 0) := by
  split_ifs with h
  · have : ⌊-y⌋ = -1 := Int.floor_eq_iff.mpr ⟨by push_cast; linarith, by push_cast; linarith⟩
    omega
  · have : y = 0 := by linarith
    subst this; simp

theorem fl1 (x y : ℚ) (q : ℤ) (h1 : (q : ℚ) < x) (h2 : x < q + 1) (hy0 : 0 ≤ y) (hy1 : y < 1) :
    ⌊x - y⌋ = q - (if x - q < y then 1 else 0) := by
  rw [Int.floor_eq_iff]
  split_ifs with h <;> push_cast <;> constructor <;> linarith

theorem fl2 (x y : ℚ) (q : ℤ) (h1 : (q : ℚ) < x) (h2 : x < q + 1) (hy0 : 0 ≤ y) (hy1 : y < 1) :
    ⌈-x - y⌉ = -q - (if 1 - x + q ≤ y then 1 else 0) := by
  rw [Int.ceil_eq_iff]
  split_ifs with h <;> push_cast <;> constructor <;> linarith

theorem fl3 (x y : ℚ) (q : ℤ) (h1 : (q : ℚ) < x) (h2 : x < q + 1) (hy0 : 0 ≤ y) (hy1 : y < 1) :
    ⌊-x - y⌋ = -q - 1 - (if 1 - x + q < y then 1 else 0) := by
  rw [Int.floor_eq_iff]
  split_ifs with h <;> push_cast <;> constructor <;> linarith

/-- The actual threshold bits at `(f, y)`. -/
def bitsOf (q : List ℤ) (f y : ℚ) : List Bool :=
  [decide (thr q f 0 < y), decide (thr q f 1 < y), decide (thr q f 2 < y), decide (thr q f 3 < y),
   decide (thr q f 4 < y), decide (thr q f 5 < y), decide (thr q f 6 < y), decide (thr q f 7 < y),
   decide (thr q f 8 ≤ y), decide (thr q f 9 ≤ y)]

theorem bitsOf_getD (q : List ℤ) (f y : ℚ) (i : ℕ) (hi : i < 10) :
    (bitsOf q f y).getD i false = true ↔ (if i < 8 then thr q f i < y else thr q f i ≤ y) := by
  interval_cases i <;> simp [bitsOf]

theorem thr_affine (q : List ℤ) (f : ℚ) (i : ℕ) :
    thr q f i = thr q 0 i + f * (thr q 1 i - thr q 0 i) := by
  rcases i with _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | i <;> simp [thr] <;> ring

theorem thr_lt (q : List ℤ) (c d f : ℚ) (hc : c < f) (hd : f < d) (a b : ℕ)
    (h1 : 0 ≤ thr q c b - thr q c a) (h2 : 0 ≤ thr q d b - thr q d a)
    (h3 : 0 < (thr q c b - thr q c a) + (thr q d b - thr q d a)) :
    thr q f a < thr q f b := by
  have ea := thr_affine q c a; have eb := thr_affine q c b
  have ea' := thr_affine q d a; have eb' := thr_affine q d b
  have fa := thr_affine q f a; have fb := thr_affine q f b
  set A0 := thr q 0 a; set A1 := thr q 1 a; set B0 := thr q 0 b; set B1 := thr q 1 b
  -- `g(x) = (B0 - A0) + x (B1 - A0 - (A1 - A0))` is affine
  have key : (thr q f b - thr q f a) * (d - c) =
      (d - f) * (thr q c b - thr q c a) + (f - c) * (thr q d b - thr q d a) := by
    rw [ea, eb, ea', eb', fa, fb]; ring
  have hdc : 0 < d - c := by linarith
  have : 0 < (d - f) * (thr q c b - thr q c a) + (f - c) * (thr q d b - thr q d a) := by
    rcases lt_or_eq_of_le h1 with h | h
    · have := mul_pos (by linarith : (0 : ℚ) < d - f) h
      have := mul_nonneg (by linarith : (0 : ℚ) ≤ f - c) h2
      linarith
    · have h4 : 0 < thr q d b - thr q d a := by linarith
      have := mul_pos (by linarith : (0 : ℚ) < f - c) h4
      rw [← h]; linarith
  rw [← key] at this
  by_contra hle
  have hle := not_lt.mp hle
  nlinarith

theorem mem_allVecs : ∀ v : List Bool, v ∈ allVecs v.length
  | [] => by simp [allVecs]
  | x :: v => by
    rw [List.length_cons, allVecs, List.mem_flatMap]
    exact ⟨v, mem_allVecs v, by cases x <;> simp⟩

/-- The `t = 0` count `h` (a copy of `ShellFirstOrder.hcount0`). -/
def hc0 (f y : ℚ) : ℤ :=
  icnt (⌊-y⌋ + 1) ⌊10 * f - y⌋ + icnt (⌊f - y⌋ + 1) ⌊11 * f - y⌋ +
      icnt (⌊2 * f - y⌋ + 1) ⌊12 * f - y⌋ -
    icnt ⌈-17 * f - y⌉ ⌊-f - y⌋ - icnt ⌈-16 * f - y⌉ ⌊-2 * f - y⌋

/-- The `t = 0` endpoints (a copy of `ShellFirstOrder.ends0`). -/
def e0 (f y : ℚ) : List (ℤ × ℤ) :=
  [(⌊-y⌋ + 1, ⌊10 * f - y⌋), (⌊f - y⌋ + 1, ⌊11 * f - y⌋), (⌊2 * f - y⌋ + 1, ⌊12 * f - y⌋),
   (⌈-17 * f - y⌉, ⌊-f - y⌋), (⌈-16 * f - y⌉, ⌊-2 * f - y⌋)]

/-- Soundness of one cell. -/
theorem cell_sound (row : List (ℤ × ℤ)) (c d : ℚ) (a1 a2 a3 a4 a5 a6 a7 : ℤ) (σ : List ℕ)
    (h : cellOK row (c, d, [a1, a2, a3, a4, a5, a6, a7], σ) = true) (f y : ℚ) (hc : c < f)
    (hd : f < d) (hy0 : 0 ≤ y) (hy1 : y < 1) :
    -1 ≤ hc0 f y ∧ (hc0 f y = -1 →
      (e0 f y).map (fun e => (e.1 - ⌊2 * f - y⌋, e.2 - ⌊2 * f - y⌋)) = row) := by
  set q := [a1, a2, a3, a4, a5, a6, a7] with hqdef
  simp only [cellOK, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨-, -⟩, hq⟩, hord⟩, hall⟩ := h
  simp [qOK, mults, hqdef] at hq
  obtain ⟨⟨b1, b1'⟩, ⟨b2, b2'⟩, ⟨b3, b3'⟩, ⟨b4, b4'⟩, ⟨b5, b5'⟩, ⟨b6, b6'⟩, ⟨b7, b7'⟩⟩ := hq
  set bs := bitsOf q f y with hbs
  have bvl : ∀ i, i < 8 → bv bs i = if thr q f i < y then 1 else 0 := fun i hi => by
    have := bitsOf_getD q f y i (by omega)
    simp only [hi, ↓reduceIte] at this
    rw [← hbs] at this
    unfold bv
    simp only [this]
  have bvle : ∀ i, 8 ≤ i → i < 10 → bv bs i = if thr q f i ≤ y then 1 else 0 := fun i hi hi' => by
    have := bitsOf_getD q f y i hi'
    simp only [show ¬ i < 8 by omega, ↓reduceIte] at this
    rw [← hbs] at this
    unfold bv
    simp only [this]
  have E0 : ⌊-y⌋ + 1 = 1 - bv bs 0 := by
    rw [fl0 y hy0 hy1, bvl 0 (by norm_num)]; simp [thr]
  have E1 : ⌊f - y⌋ = qOf q 0 - bv bs 1 := by
    rw [fl1 f y (qOf q 0) (by simp [qOf, q]; nlinarith) (by simp [qOf, q]; nlinarith) hy0 hy1,
      bvl 1 (by norm_num)]; simp [thr]
  have E2 : ⌊2 * f - y⌋ = qOf q 1 - bv bs 2 := by
    rw [fl1 _ y (qOf q 1) (by simp [qOf, q]; nlinarith) (by simp [qOf, q]; nlinarith) hy0 hy1,
      bvl 2 (by norm_num)]; simp [thr]
  have E3 : ⌊10 * f - y⌋ = qOf q 2 - bv bs 3 := by
    rw [fl1 _ y (qOf q 2) (by simp [qOf, q]; nlinarith) (by simp [qOf, q]; nlinarith) hy0 hy1,
      bvl 3 (by norm_num)]; simp [thr]
  have E4 : ⌊11 * f - y⌋ = qOf q 3 - bv bs 4 := by
    rw [fl1 _ y (qOf q 3) (by simp [qOf, q]; nlinarith) (by simp [qOf, q]; nlinarith) hy0 hy1,
      bvl 4 (by norm_num)]; simp [thr]
  have E5 : ⌊12 * f - y⌋ = qOf q 4 - bv bs 5 := by
    rw [fl1 _ y (qOf q 4) (by simp [qOf, q]; nlinarith) (by simp [qOf, q]; nlinarith) hy0 hy1,
      bvl 5 (by norm_num)]; simp [thr]
  have E6 : ⌊-f - y⌋ = -qOf q 0 - 1 - bv bs 6 := by
    rw [fl3 f y (qOf q 0) (by simp [qOf, q]; nlinarith) (by simp [qOf, q]; nlinarith) hy0 hy1,
      bvl 6 (by norm_num)]; simp [thr]
  have E7 : ⌊-2 * f - y⌋ = -qOf q 1 - 1 - bv bs 7 := by
    rw [neg_mul, fl3 _ y (qOf q 1) (by simp [qOf, q]; nlinarith) (by simp [qOf, q]; nlinarith)
      hy0 hy1, bvl 7 (by norm_num)]; simp [thr]
  have E8 : ⌈-16 * f - y⌉ = -qOf q 5 - bv bs 8 := by
    rw [neg_mul, fl2 _ y (qOf q 5) (by simp [qOf, q]; nlinarith) (by simp [qOf, q]; nlinarith)
      hy0 hy1, bvle 8 (by norm_num) (by norm_num)]; simp [thr]
  have E9 : ⌈-17 * f - y⌉ = -qOf q 6 - bv bs 9 := by
    rw [neg_mul, fl2 _ y (qOf q 6) (by simp [qOf, q]; nlinarith) (by simp [qOf, q]; nlinarith)
      hy0 hy1, bvle 9 (by norm_num) (by norm_num)]; simp [thr]
  -- the actual bits are monotone along `σ`
  simp only [ordOK, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at hord
  obtain ⟨hσ, hpairs⟩ := hord
  have hchain : chainOK σ bs = true := by
    simp only [chainOK, List.all_eq_true, Bool.or_eq_true, Bool.not_eq_true']
    intro pr hpr
    obtain ⟨⟨h1, h2⟩, h3⟩ := hpairs pr hpr
    have hlt := thr_lt q c d f hc hd pr.1 pr.2 h1 h2 h3
    have hm := List.of_mem_zip hpr
    have hi1 : pr.1 < 10 := hσ _ hm.1
    have hi2 : pr.2 < 10 := hσ _ (List.mem_of_mem_tail hm.2)
    by_cases hb2 : bs.getD pr.2 false = true
    · right
      have g2 := (bitsOf_getD q f y pr.2 hi2).mp hb2
      have g2' : thr q f pr.2 ≤ y := by split_ifs at g2 <;> linarith
      refine (bitsOf_getD q f y pr.1 hi1).mpr ?_
      split_ifs <;> linarith
    · left; simpa using hb2
  have hgood := List.all_eq_true.mp hall bs (by simpa [hbs, bitsOf] using mem_allVecs bs)
  rw [hchain] at hgood
  simp only [Bool.not_true, Bool.false_or, goodB, Bool.and_eq_true, decide_eq_true_eq,
    Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not] at hgood
  have hH : hc0 f y = hB q bs := by
    rw [hc0, E0, E1, E2, E3, E4, E5, E6, E7, E8, E9]; rfl
  have hE : e0 f y = endsB q bs := by
    rw [e0, E0, E1, E2, E3, E4, E5, E6, E7, E8, E9]; rfl
  rw [hH, hE, E2]
  refine ⟨hgood.1, fun hm1 => ?_⟩
  rcases hgood.2 with h' | h'
  · exact absurd hm1 h'
  · exact h'

/-- Soundness of one cell, for a floor list of any shape. -/
theorem cell_sound' (row : List (ℤ × ℤ)) (cell : Cell) (h : cellOK row cell = true) (f y : ℚ)
    (hc : cell.1 < f) (hd : f < cell.2.1) (hy0 : 0 ≤ y) (hy1 : y < 1) :
    -1 ≤ hc0 f y ∧ (hc0 f y = -1 →
      (e0 f y).map (fun e => (e.1 - ⌊2 * f - y⌋, e.2 - ⌊2 * f - y⌋)) = row) := by
  obtain ⟨c, d, q, σ⟩ := cell
  have hlen : q.length = 7 := by
    simp only [cellOK, qOK, Bool.and_eq_true, decide_eq_true_eq] at h
    exact h.1.1.2.1
  obtain ⟨a1, a2, a3, a4, a5, a6, a7, rfl⟩ :
      ∃ a1 a2 a3 a4 a5 a6 a7 : ℤ, q = [a1, a2, a3, a4, a5, a6, a7] := by
    rcases q with _ | ⟨a1, _ | ⟨a2, _ | ⟨a3, _ | ⟨a4, _ | ⟨a5, _ | ⟨a6, _ | ⟨a7, _ | ⟨a8, q⟩⟩⟩⟩⟩⟩⟩⟩ <;>
      simp at hlen ⊢
  exact cell_sound row c d a1 a2 a3 a4 a5 a6 a7 σ h f y hc hd hy0 hy1

/-- A point of `(a, b)` off the right endpoints of a covering lies in one of its cells. -/
theorem covers_locate : ∀ (cells : List Cell) (a b f : ℚ), covers a b cells = true → a < f →
    f < b → (∀ cell ∈ cells, f ≠ cell.2.1) → ∃ cell ∈ cells, cell.1 < f ∧ f < cell.2.1
  | [], _, _, _, h, _, _, _ => by simp [covers] at h
  | [cell], a, b, f, h, ha, hb, _ => by
    simp only [covers, Bool.and_eq_true, decide_eq_true_eq] at h
    exact ⟨cell, List.mem_singleton_self _, h.1 ▸ ha, h.2 ▸ hb⟩
  | cell :: c2 :: rest, a, b, f, h, ha, hb, hne => by
    simp only [covers, Bool.and_eq_true, decide_eq_true_eq] at h
    rcases lt_or_gt_of_ne (hne cell List.mem_cons_self) with h1 | h1
    · exact ⟨cell, List.mem_cons_self, h.1 ▸ ha, h1⟩
    · obtain ⟨c, hc, hc'⟩ := covers_locate (c2 :: rest) cell.2.1 b f h.2 h1 hb
        (fun c hc => hne c (List.mem_cons_of_mem _ hc))
      exact ⟨c, List.mem_cons_of_mem _ hc, hc'⟩

/-- **The chamber certificate** (statement of `ShellFirstOrder.root_count_cert`, with the
copies `tbl`, `hc0`, `e0`). -/
theorem cert_main (f y : ℚ) (row : (ℚ × ℚ) × List (ℤ × ℤ)) (hrow : row ∈ tbl)
    (hf : row.1.1 < f ∧ f < row.1.2)
    (hF : ∀ q : ℕ, 0 < q → q ≤ 29 → ∀ m : ℤ, f * q ≠ m) (hy : 0 ≤ y ∧ y < 1) :
    -1 ≤ hc0 f y ∧ (hc0 f y = -1 →
      (e0 f y).map (fun e => (e.1 - ⌊2 * f - y⌋, e.2 - ⌊2 * f - y⌋)) = row.2) := by
  obtain ⟨i, hi⟩ := List.mem_iff_getElem?.mp hrow
  have hi14 : i < 14 := by
    by_contra h
    rw [List.getElem?_eq_none (by simp [tbl]; omega)] at hi
    exact absurd hi (by simp)
  have hall : ∀ i < 14, rowOK i = true := by
    intro i hi
    interval_cases i
    exacts [rowOK_0, rowOK_1, rowOK_2, rowOK_3, rowOK_4, rowOK_5, rowOK_6, rowOK_7, rowOK_8,
      rowOK_9, rowOK_10, rowOK_11, rowOK_12, rowOK_13]
  have hok := hall i hi14
  unfold rowOK at hok
  rw [hi] at hok
  rcases hc : certCells[i]? with _ | cells
  · rw [hc] at hok; exact absurd hok (by simp)
  rw [hc] at hok
  simp only [Bool.and_eq_true, List.all_eq_true] at hok
  obtain ⟨cell, hcell, h1, h2⟩ := covers_locate cells _ _ f hok.1 hf.1 hf.2 (fun cell hcell heq => by
    have h29 : cell.2.1.den ≤ 29 := by
      have := hok.2 cell hcell
      simp only [cellOK, Bool.and_eq_true, decide_eq_true_eq] at this
      exact this.1.1.1.2
    exact hF cell.2.1.den (Rat.den_pos _) h29 cell.2.1.num (by rw [heq]; exact Rat.mul_den_eq_num _))
  exact cell_sound' row.2 cell (hok.2 cell hcell) f y h1 h2 hy.1 hy.2

end Meijer5255.ShellFirstOrder.Cert
