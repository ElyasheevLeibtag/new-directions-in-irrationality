/-- Row `i` of the table, with its cells, passes the check. -/
def rowOK (i : ℕ) : Bool :=
  match tbl[i]?, certCells[i]? with
  | some row, some cells => covers row.1.1 row.1.2 cells && cells.all (cellOK row.2)
  | _, _ => false

